{
  "name": "survival-backend",
  "version": "1.0.0",
  "description": "Node.js backend for mobile survival game - Express, PostgreSQL, Redis, JWT",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/db/migrate.js",
    "init-db": "psql -U postgres -d survival_game -f src/db/schema.sql"
  },
  "keywords": ["express", "postgresql", "redis", "jwt", "survival-game"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
